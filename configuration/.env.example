# Required by Hawking, both native and Docker Compose runs.
HAWKING__CORE__DISCORD__TOKEN=replace-with-your-discord-bot-token

# Optional for local DynamoDB access. For temporary credentials, set all three.
# HAWKING__CORE__AWS__ACCESS_KEY_ID=
# HAWKING__CORE__AWS__SECRET_ACCESS_KEY=
# HAWKING__CORE__AWS__SESSION_TOKEN=

# Reddit API credentials. Replace these placeholders in configuration/.env.
ADDONS__REDDIT__CLIENT_ID=replace-with-your-reddit-client-id
ADDONS__REDDIT__CLIENT_SECRET=replace-with-your-reddit-client-secret
