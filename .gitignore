# Don't share and old versions of files
*old.*

# Ignore these directories
bin/
include/
lib/
local/
tmp/
temp/

Include/
Lib/
Scripts/
tcl/
etc/
share/

# Ignore non-public config environment files
configuration/config.*.json
configuration/.env

# Ignore dev environment project files
*.vscode
*.sublime-project
*.sublime-workspace

# Ignore gitattributes
.gitattributes

# Ignore pip files
pip-selfcheck.json

# Ignore .pyc files
*.pyc

# Ignore venv files
pyvenv.cfg

# Ignore credentials
.env
token.json
code/addons/*.json

# Ignore misc phrase files, but include default phrases
code/addons/phrases/phrases/*
!code/addons/phrases/phrases/classics.json

# Ignore logfiles
logs/*
*.log
docker-data/

# Ignore delete_requests & container
privacy/*

# Ignore linter config
*.pylintrc

# todo: where is this pickle file coming from?
update_checker_cache.pkl

# Keep Docker helper scripts out of the virtualenv Scripts/ ignore rule
!docker/scripts/
!docker/scripts/*.sh